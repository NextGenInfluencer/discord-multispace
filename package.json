{
  "name": "discord-multispace",
  "version": "2.0.0",
  "description": "Production-grade, lightweight multi-account Discord desktop client powered by Electron",
  "main": "main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:e2e": "electron tests/e2e-electron.js",
    "make-shortcut": "node create-shortcut.js",
    "build": "electron-builder --win nsis",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.nextgeninfluencer.discordmultispace",
    "productName": "Discord MultiSpace",
    "artifactName": "Discord-MultiSpace-Setup-${version}.${ext}",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "NextGenInfluencer",
      "repo": "discord-multispace"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Discord MultiSpace",
      "runAfterFinish": true
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "lib/**/*",
      "assets/**/*",
      "tray-icon.png",
      "tray-icon.svg",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "keywords": [
    "discord",
    "multi-account",
    "electron",
    "multispace"
  ],
  "author": "NextGenInfluencer",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "overrides": {
    "minimatch": "^11.0.9"
  }
}
